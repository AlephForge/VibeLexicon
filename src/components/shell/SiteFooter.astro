---
// VibeLexicon 全站 Footer（Shell）
const year = new Date().getFullYear();
const BASE = import.meta.env.BASE_URL;
const GH_URL = 'https://github.com/AlephForge/VibeLexicon';
const PRD_URL = 'https://github.com/AlephForge/VibeLexicon/blob/main/docs/PRD.md';
const GITHUB_PATH =
  'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12';

const navItems = [
  { href: `${BASE}`, label: '图鉴' },
  { href: `${BASE}docs/`, label: '文档' },
  { href: `${BASE}docs/stream/`, label: '连续阅读' },
  { href: `${BASE}about/`, label: '关于' },
];
---

<footer class="site-footer">
  <div class="container-lexicon">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__logo">
          VibeLexicon<span class="site-footer__dot" aria-hidden="true">.</span>
        </p>
        <p class="site-footer__tagline">把 UI 术语，变成看得见的灵感。</p>
      </div>

      <nav class="site-footer__col" aria-label="页脚导航">
        <p class="section-label site-footer__heading">浏览</p>
        <ul class="site-footer__list">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <p class="section-label site-footer__heading">项目</p>
        <a href={GH_URL} target="_blank" rel="noopener noreferrer" class="site-footer__github">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d={GITHUB_PATH} />
          </svg>
          GitHub 仓库
        </a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} VibeLexicon · 内容为项目重新整理，保留来源 Attribution</p>
      <a href={PRD_URL} target="_blank" rel="noopener noreferrer" class="site-footer__prd">
        设计规格 · docs/PRD.md
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
  }
  .site-footer__grid {
    display: grid;
    gap: 2rem;
    padding: 3rem 0 2rem;
    grid-template-columns: 1fr;
  }
  .site-footer__logo {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .site-footer__dot {
    color: var(--color-accent);
  }
  .site-footer__tagline {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .site-footer__heading {
    margin-bottom: 0.75rem;
  }
  .site-footer__list {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__list a {
    display: inline-block;
    padding: 0.375rem 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--duration-feedback) var(--ease-feedback);
  }
  .site-footer__list a:hover {
    color: var(--color-ink);
  }
  .site-footer__github {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--duration-feedback) var(--ease-feedback);
  }
  .site-footer__github:hover {
    color: var(--color-ink);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 1.25rem 0 2rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.8125rem;
  }
  .site-footer__prd {
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-feedback) var(--ease-feedback);
  }
  .site-footer__prd:hover {
    color: var(--color-accent-deep);
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
