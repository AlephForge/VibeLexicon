---
// Docs 目录 Sidebar（Issue #8 / Docs Agent F）
// - 同一 DOM 两种形态：<64rem 为左侧滑入抽屉（.is-open 由 DocsLayout drawer 岛控制）；
//   ≥64rem 为常驻 sticky 侧栏（top: var(--header-h)）。
// - 服务端预过滤：当前 ?q= / ?category= 下不匹配的词条链接渲染 hidden（无 JS 也正确）。
// - 客户端唯一交互：DocsLayout mode="filter"（client:idle）——实时筛选 + replaceState ?q=
//   并更新 [data-docs-count] 分类计数。
import DocsLayout from '@/components/docs/DocsLayout.vue';
import { CATEGORIES } from '@/lib/categories';
import { filterPatterns, type PatternIndex } from '@/lib/patterns';

interface Props {
  patterns: PatternIndex[];
  q: string;
  category: string | null;
  matchedSlugs: Set<string>;
  categoryMeta: Array<{ key: string; name: string; nameZh: string; desc: string }>;
}

const { patterns, q, category, matchedSlugs, categoryMeta } = Astro.props as Props;
const BASE = import.meta.env.BASE_URL;

// 目录内链接：保留当前 q；分类链接附加 ?category=，「全部」不带 category 参数
const categoryHref = (key: string | null): string => {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (key) params.set('category', key);
  const qs = params.toString();
  return `${BASE}docs/${qs ? `?${qs}` : ''}`;
};

// 服务端计数（全局 q 视角，忽略当前 category 参数）：
// 「全部」头与每分类头都显示“命中的词条数”，无 JS 时与岛更新结果一致。
const countAll = filterPatterns(patterns, q, null).length;
const grouped = CATEGORIES.map((cat) => ({
  ...cat,
  count: filterPatterns(patterns, q, null).filter((p) => p.category === cat.key).length,
  items: patterns.filter((p) => p.category === cat.key),
}));
---

<aside id="docs-sidebar" class="docs-sidebar" aria-label="文档目录">
  <div class="docs-sidebar__scrim" data-docs-drawer-scrim></div>

  <div class="docs-sidebar__panel">
    <div class="docs-sidebar__head">
      <span class="docs-sidebar__head-title">Docs 目录</span>
      <button
        type="button"
        class="docs-sidebar__close"
        data-docs-drawer-close
        aria-label="关闭目录"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="docs-sidebar__filter">
      <DocsLayout
        mode="filter"
        client:idle
        patterns={patterns}
        initialQ={q}
        initialCategory={category}
        categories={categoryMeta}
      />
    </div>

    <nav class="docs-nav" aria-label="词条目录">
      <a
        href={categoryHref(null)}
        data-docs-cat-head
        data-cat-key="all"
        class:list={['docs-nav__cat', { 'is-active': category === null }]}
        aria-current={category === null ? 'page' : undefined}
      >
        <span class="docs-nav__cat-text">
          <span class="docs-nav__cat-name">All Patterns</span>
          <span class="docs-nav__cat-zh">全部模式</span>
        </span>
        <span class="docs-nav__cat-count" data-docs-count="all">{countAll}</span>
      </a>

      {
        grouped.map((cat) => (
          <div class="docs-nav__group">
            <a
              href={categoryHref(cat.key)}
              data-docs-cat-head
              data-cat-key={cat.key}
              class:list={['docs-nav__cat', { 'is-active': category === cat.key }]}
              aria-current={category === cat.key ? 'page' : undefined}
            >
              <span class="docs-nav__cat-text">
                <span class="docs-nav__cat-name">{cat.name}</span>
                <span class="docs-nav__cat-zh">{cat.nameZh}</span>
              </span>
              <span class="docs-nav__cat-count" data-docs-count={cat.key}>{cat.count}</span>
            </a>

            <ul class="docs-nav__list">
              {
                cat.items.map((p) => (
                  <li>
                    <a
                      href={`${BASE}patterns/${p.slug}/`}
                      class="docs-nav__link"
                      data-sidebar-pattern
                      data-slug={p.slug}
                      hidden={matchedSlugs.has(p.slug) ? undefined : true}
                    >
                      <span class="docs-nav__ord" aria-hidden="true">
                        {String(p.order).padStart(2, '0')}
                      </span>
                      {p.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
</aside>

<style>
  /* ── 抽屉态（<64rem）：左侧滑入目录抽屉 ── */
  .docs-sidebar {
    position: fixed;
    inset: 0;
    z-index: 70;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-drawer) var(--ease-feedback),
      visibility 0s linear var(--duration-drawer);
  }
  .docs-sidebar.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition: opacity var(--duration-drawer) var(--ease-feedback);
  }
  .docs-sidebar__scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-dark-bg) 40%, transparent);
  }
  .docs-sidebar__panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    width: min(19rem, 86vw);
    background: var(--color-surface);
    border-right: 1px solid var(--color-line);
    transform: translateX(-100%);
    transition: transform var(--duration-drawer) var(--ease-feedback);
  }
  .docs-sidebar.is-open .docs-sidebar__panel {
    transform: translateX(0);
  }
  .docs-sidebar__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.75rem 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .docs-sidebar__head-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .docs-sidebar__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      background-color var(--duration-feedback) var(--ease-feedback),
      color var(--duration-feedback) var(--ease-feedback);
  }
  .docs-sidebar__close:hover {
    background: var(--color-tag-bg);
    color: var(--color-ink);
  }

  /* 筛选框固定，词条目录独立滚动 */
  .docs-sidebar__filter {
    flex-shrink: 0;
    padding: 0.875rem 1rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .docs-nav {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 0.625rem 2rem;
  }

  /* 分类头 */
  .docs-nav__cat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    padding: 0.4375rem 0.5rem;
    margin-top: 0.25rem;
    border-radius: var(--radius-control);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--duration-feedback) var(--ease-feedback);
  }
  .docs-nav__cat:hover {
    background: var(--color-tag-bg);
  }
  .docs-nav__cat-text {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
  }
  .docs-nav__cat-zh {
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .docs-nav__cat-count {
    flex-shrink: 0;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-tag-bg);
    color: var(--color-muted);
    font-size: 0.6875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .docs-nav__cat.is-active {
    background: var(--color-dark-bg);
    color: var(--color-card);
  }
  .docs-nav__cat.is-active .docs-nav__cat-zh,
  .docs-nav__cat.is-active .docs-nav__cat-count {
    color: color-mix(in srgb, var(--color-card) 78%, transparent);
  }
  .docs-nav__cat.is-active .docs-nav__cat-count {
    background: color-mix(in srgb, var(--color-card) 16%, transparent);
  }
  .docs-nav__cat.is-active:hover {
    background: var(--color-dark-bg);
  }

  /* 词条链接 */
  .docs-nav__list {
    list-style: none;
    margin: 0;
    padding: 0.125rem 0 0.375rem 0.375rem;
  }
  .docs-nav__link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.25rem 0.5rem 0.25rem 0.875rem;
    border-left: 1px solid var(--color-line);
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    transition:
      color var(--duration-feedback) var(--ease-feedback),
      background-color var(--duration-feedback) var(--ease-feedback);
  }
  .docs-nav__link:hover {
    color: var(--color-ink);
    background: var(--color-surface);
  }
  .docs-nav__ord {
    flex-shrink: 0;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-line);
  }

  /* ── 桌面（≥64rem）：常驻 sticky 侧栏（与抽屉同一 DOM，仅切换 CSS） ── */
  @media (min-width: 64rem) {
    .docs-sidebar {
      position: sticky;
      top: var(--header-h);
      z-index: 0;
      height: calc(100vh - var(--header-h));
      align-self: start;
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
    }
    .docs-sidebar__scrim {
      display: none;
    }
    .docs-sidebar__panel {
      position: static;
      width: auto;
      transform: none;
      background: transparent;
    }
    .docs-sidebar__head {
      display: none;
    }
  }

  /* 抽屉打开时锁定背景滚动 */
  :global(body.docs-drawer-open) {
    overflow: hidden;
  }
</style>