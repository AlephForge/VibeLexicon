---
// Stream Sticky 目录（Issue #9 / Stream Agent J）—— 纯 SSR 骨架。
//
// - 四分类 → 词条，词条为真实锚点链接（href="#{slug}"），无 JS 可纯跳转；
// - SSR 默认高亮第一项（is-active + aria-current="true"）；
// - Active 同步由 StreamTocSync.vue（client:idle，唯一交互岛）接管：
//     单 IntersectionObserver + is-active 类切换 + 目录自滚动到当前项可见；
// - data-stream-toc-container：目录自滚动容器（island 用）；
// - data-stream-toc-cat / data-stream-toc-link：?category= 客户端收缩 / Active 切换的挂钩。
import type { Category } from '@/lib/categories';
import type { PatternIndex } from '@/lib/patterns';
import StreamTocSync from './StreamTocSync.vue';

interface Props {
  categories: Array<{ key: Category['key']; name: string; nameZh: string }>;
  groups: Array<{ key: string; name: string; nameZh: string; items: PatternIndex[] }>;
}

const { groups, categories } = Astro.props;
const firstSlug = groups[0]?.items[0]?.slug ?? '';
---

<aside class="stream-toc" aria-label="连续阅读目录">
  <div class="stream-toc__inner" data-stream-toc-container>
    <p class="section-label stream-toc__label">本页目录</p>

    <nav class="stream-toc__nav" aria-label="词条目录">
      <ol class="stream-toc__list">
        {
          groups.map((g) => (
            <li class="stream-toc__group" data-stream-toc-cat={g.key}>
              <a class="stream-toc__cat" href={`#${g.key}`}>
                {g.name}
                <span class="stream-toc__cat-zh">{g.nameZh}</span>
              </a>
              <ul class="stream-toc__items">
                {
                  g.items.map((p) => (
                    <li class="stream-toc__item">
                      <a
                        href={`#${p.slug}`}
                        data-stream-toc-link
                        data-slug={p.slug}
                        class:list={[
                          'stream-toc__link',
                          { 'is-active': p.slug === firstSlug },
                        ]}
                        aria-current={p.slug === firstSlug ? 'true' : undefined}
                      >
                        {p.title}
                        <span class="stream-toc__zh">{p.titleZh}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </li>
          ))
        }
      </ol>
    </nav>

    <!-- 唯一交互岛：Scroll Spy + ?category= 客户端收缩 + 上下文链接补写 -->
    <StreamTocSync client:idle categories={categories} />
  </div>
</aside>

<style>
  /* 桌面（lg+，≥64rem）才显示 sticky 目录；移动端起纯锚点/折叠入口 */
  .stream-toc {
    display: none;
  }
  @media (min-width: 64rem) {
    .stream-toc {
      display: block;
    }
  }

  .stream-toc__inner {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    max-height: calc(100vh - var(--header-h) - 3rem);
    overflow-y: auto;
    padding-right: 0.375rem;
  }

  .stream-toc__label {
    display: block;
    margin-bottom: 0.75rem;
  }

  .stream-toc__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stream-toc__cat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.125rem 0 0.375rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition: color var(--duration-feedback) var(--ease-feedback);
  }
  .stream-toc__cat:hover {
    color: var(--color-accent-deep);
  }
  .stream-toc__cat-zh {
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--color-muted-strong);
  }

  .stream-toc__items {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .stream-toc__link {
    display: block;
    padding: 0.25rem 0.5rem;
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-muted-strong);
    text-decoration: none;
    transition:
      color var(--duration-feedback) var(--ease-feedback),
      border-color var(--duration-feedback) var(--ease-feedback),
      background-color var(--duration-feedback) var(--ease-feedback);
  }
  .stream-toc__link:hover {
    color: var(--color-ink);
    border-left-color: var(--color-accent-soft);
  }
  .stream-toc__link.is-active,
  .stream-toc__link.is-active:hover {
    color: var(--color-accent-deep);
    border-left-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .stream-toc__zh {
    margin-left: 0.375rem;
    font-size: 0.75rem;
    color: var(--color-muted-strong);
  }
</style>