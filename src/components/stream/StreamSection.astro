---
// Stream 词条区块（Issue #9 / Stream Agent J）—— 连续阅读流中的单条目布局。
//
// 结构（PRD §8）：
//   序号 + Serif 英文名 + 中文名 + 徽标（hasFull →「完整交互 · 见详情」，否则「静态示例」）
//   → summary（一句话定位）
//   → Mini Preview（全静态 SSR，禁止任何 Full Demo / demo island）
//   → 是什么（whatIs）→ 适合场景（useCases）/ 不适合·边界（limitations）两栏
//   →「打开详情」→ /patterns/{slug}/
//
// 锚点：<section id={slug}> 供目录跳转与 StreamTocSync 的 IntersectionObserver 观察。
import type { PatternData } from '@/lib/pattern-schema';
import { hasFull } from '@/demos/registry';
import { miniComponents } from '@/demos/components';

interface Props {
  pattern: PatternData;
  /** 阅读流全局序号（1–40），用于「连续读」定位 */
  index: number;
  /** BASE_URL 前缀，用于拼接 Detail 链接 */
  base: string;
}

const { pattern, index, base } = Astro.props;
const Mini = miniComponents[pattern.preview];
const full = hasFull(pattern.preview);
---

<section id={pattern.slug} data-stream-section class="stream-section">
  <header class="stream-section__head">
    <p class="stream-section__meta">
      <span class="stream-section__ord" aria-hidden="true">
        {String(index).padStart(2, '0')}
      </span>
      {
        full ? (
          <a class="tag stream-section__full" href={`${base}patterns/${pattern.slug}/`}>
            完整交互 · 见详情
          </a>
        ) : (
          <span class="tag">静态示例</span>
        )
      }
    </p>

    <h2 class="stream-section__title">
      {pattern.title}
      <span class="stream-section__zh">{pattern.titleZh}</span>
    </h2>

    <p class="stream-section__summary">{pattern.summary}</p>
  </header>

  <div class="stream-section__preview" aria-label={`${pattern.title} · ${pattern.titleZh} 示例预览`}>
    <Mini />
  </div>

  <div class="stream-section__body">
    <div>
      <h3 class="stream-section__h3">是什么</h3>
      <p class="stream-section__whatis">{pattern.whatIs}</p>
    </div>

    <div class="stream-section__cols">
      <div>
        <h3 class="stream-section__h3">适合场景</h3>
        <ul class="stream-section__list">
          {
            pattern.useCases.map((item) => (
              <li class="stream-section__li">
                <span aria-hidden="true" class="stream-section__bullet">+</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="stream-section__h3">不适合 · 边界</h3>
        <ul class="stream-section__list">
          {
            pattern.limitations.map((item) => (
              <li class="stream-section__li">
                <span aria-hidden="true" class="stream-section__bullet stream-section__bullet--minus">–</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <footer class="stream-section__foot">
    <a class="btn btn--ghost" href={`${base}patterns/${pattern.slug}/`}>
      打开详情
      <span aria-hidden="true">→</span>
    </a>
  </footer>
</section>

<style>
  .stream-section {
    /* 锚点不被 Sticky Header 遮挡：由 tokens.css 全局 scroll-padding-top 统一处理
       （若此处再设 scroll-margin-top 会与全局 scroll-padding 叠加、产生双倍偏移） */
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .stream-section__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stream-section__meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
  }
  .stream-section__ord {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--color-line);
  }
  .stream-section__full {
    text-decoration: none;
    transition: color var(--duration-feedback) var(--ease-feedback);
  }
  .stream-section__full:hover {
    color: var(--color-accent-deep);
  }

  .stream-section__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .stream-section__zh {
    margin-left: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .stream-section__summary {
    max-width: 46rem;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-muted-strong);
  }

  .stream-section__preview {
    margin-top: 1.25rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  @media (min-width: 40rem) {
    .stream-section__preview {
      padding: 1rem;
    }
  }

  .stream-section__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 48rem) {
    .stream-section__cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .stream-section__h3 {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
  }

  .stream-section__whatis {
    max-width: 46rem;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-ink);
    white-space: pre-line;
  }

  .stream-section__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stream-section__li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-ink);
  }
  .stream-section__bullet {
    flex: none;
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--color-accent);
  }
  .stream-section__bullet--minus {
    color: var(--color-muted);
  }

  .stream-section__foot {
    margin-top: 1.25rem;
  }
</style>