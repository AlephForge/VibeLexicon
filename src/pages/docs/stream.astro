---
// Stream 连续阅读页（Issue #9 / Stream Agent J）
//
// 连续阅读（PRD §8）：学习者按章节顺序读完 40 个 Pattern。
//   - 阅读流按 CATEGORIES 顺序 → 分类内 order；每个 Pattern 一个 <section id={slug}>：
//     序号 + Serif 英文名 + 中文名 + 徽标（hasFull →「完整交互 · 见详情」）
//     → Mini 静态预览 → summary → 是什么（whatIs）→ 适合场景（useCases）/ 不适合（limitations）
//     →「打开详情」/patterns/{slug}/
//   - 零 Full Demo / 零 demo island：Mini 全静态 SSR（Static First，禁 40 个 Hydrate）。
//   - 两栏：左主区单列阅读流 + 右 Sticky 目录（lg+）；Mobile 单列 + 顶部横向分类 chips（从简）。
//   - 唯一交互岛 StreamTocSync（client:idle）：IntersectionObserver 同步 Active；
//     并按 ?category= 客户端收缩阅读流 / 目录 / chips（SSR 读不到 query 的非阻断兜底）。
//   - URL 上下文：视图切换「索引 / 图鉴」用 buildContextLink 携带 q/category。
import BaseLayout from '@/layouts/BaseLayout.astro';
import StreamToc from '@/components/stream/StreamToc.astro';
import StreamSection from '@/components/stream/StreamSection.astro';
import type { PatternIndex } from '@/lib/patterns';
import { sortPatterns } from '@/lib/patterns';
import { CATEGORIES } from '@/lib/categories';
import { buildContextLink } from '@/lib/url';
import { getCollection } from 'astro:content';

const entries = await getCollection('patterns');

// One Source, Four Views：与 Gallery / Docs 同一 PatternIndex 最小投影 + 同一排序
const patternIndex: PatternIndex[] = sortPatterns(
  entries.map((p) => ({
    slug: p.data.slug,
    title: p.data.title,
    titleZh: p.data.titleZh,
    category: p.data.category,
    order: p.data.order,
    summary: p.data.summary,
    tags: p.data.tags,
    preview: p.data.preview,
  })),
);
const entriesBySlug = new Map(entries.map((p) => [p.data.slug, p]));
// 阅读流全局序号 = 排序后位置（1–40）
const globalIndex = new Map<string, number>(
  patternIndex.map((p, i) => [p.slug, i + 1]),
);

const groups = CATEGORIES.map((cat) => ({
  key: cat.key,
  name: cat.name,
  nameZh: cat.nameZh,
  items: patternIndex.filter((p) => p.category === cat.key),
}));
const categoriesMeta = CATEGORIES.map((c) => ({
  key: c.key,
  name: c.name,
  nameZh: c.nameZh,
}));

const totalCount = patternIndex.length;

const BASE = import.meta.env.BASE_URL;
const indexHref = buildContextLink('/docs', Astro.url);
const galleryHref = buildContextLink('/', Astro.url);
const streamHref = `${BASE}docs/stream/`;

// 分类一句说明（流式页页级文案；分类顺序与取名来自 lib/categories，不反写共享库）
const CATEGORY_DESC: Record<string, string> = {
  layout: '页面排布的骨架：栅格、卡片与流式如何组织内容的空间与密度。',
  'page-structure': '站点级结构模式：从单页到多页，从落地页、案例页到 FAQ 与页脚。',
  navigation: '移动与切换的模式：用户如何到达、返回，以及在平级视图之间切换。',
  components: '高频交互组件：弹窗、抽屉、标签、提示与命令式反馈，保证一致可用。',
};
---

<BaseLayout
  title="连续阅读 · 40 个界面模式词条 | VibeLexicon"
  description="按分类顺序连续读完 VibeLexicon 的 40 个界面模式词条：每篇含静态迷你示例、是什么、适合场景与边界，目录随滚动同步当前位置。"
>
  <div class="stream-shell" id="stream-top">
    <!-- 左：主阅读流 -->
    <div class="stream-main">
      <!-- 页头：说明 + 视图切换 + 面包屑 -->
      <header class="stream-header">
        <p class="stream-header__crumb">
          Docs <span aria-hidden="true">/</span> 连续阅读
        </p>
        <h1 class="stream-header__title">连续阅读</h1>
        <p class="stream-header__desc">
          按分类顺序读完 40 个界面模式词条。每篇含迷你示例、是什么、适合场景与边界；
          右侧目录随滚动同步当前位置。
        </p>
        <p class="stream-header__meta">
          <span class="section-label">共 {totalCount} 个词条</span>
          <span class="tag" data-stream-cat-tag hidden></span>
        </p>

        <div class="stream-toolbar">
          <div class="stream-view-switch" role="group" aria-label="视图切换">
            <a
              class="stream-view-switch__link is-active"
              href={streamHref}
              aria-current="page"
            >
              连续阅读
            </a>
            <a
              class="stream-view-switch__link"
              href={indexHref}
              data-stream-index-link
            >
              索引
            </a>
          </div>
          <a class="stream-toolbar__gallery" href={galleryHref} data-stream-gallery-link>
            图鉴 ↗
          </a>
        </div>
      </header>

      <!-- Mobile（<lg）：横向分类 chips，常驻侧栏的轻量替代 -->
      <nav class="stream-cats scrollbar-hide" aria-label="分类快速跳转">
        {
          CATEGORIES.map((c) => (
            <a class="chip" href={`#${c.key}`} data-stream-cat-chip={c.key}>
              {c.name}
              <span class="stream-cats__zh">{c.nameZh}</span>
            </a>
          ))
        }
      </nav>

      <!-- 连续阅读流：分类标题 + 40 个词条 section -->
      <div class="stream-feed">
        {
          groups.map((g) => (
            <div id={g.key} class="stream-cat" data-stream-cat-head={g.key}>
              <header class="stream-cat__head">
                <h2 class="stream-cat__title">
                  {g.name}
                  <span class="stream-cat__zh">{g.nameZh}</span>
                  <span class="stream-cat__count">{g.items.length}</span>
                </h2>
                <p class="stream-cat__desc">{CATEGORY_DESC[g.key]}</p>
              </header>

              <div class="stream-cat__items">
                {
                  g.items.map((p) => (
                    <StreamSection
                      pattern={entriesBySlug.get(p.slug)!.data}
                      index={globalIndex.get(p.slug) ?? p.order}
                      base={BASE}
                    />
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>

      <!-- 读完收尾：返回索引 / 图鉴 -->
      <footer class="stream-footer" aria-labelledby="stream-footer-title">
        <p id="stream-footer-title" class="stream-footer__title">
          已读完全部 {totalCount} 个词条
        </p>
        <p class="stream-footer__text">需要回顾某个词条时，可返回文档索引快速定位。</p>
        <div class="stream-footer__actions">
          <a class="btn btn--primary" href={indexHref}>返回索引</a>
          <a class="btn btn--ghost" href={galleryHref}>打开图鉴</a>
        </div>
      </footer>
    </div>

    <!-- 右（lg+）：Sticky 目录（SSR 骨架 + 唯一交互岛） -->
    <StreamToc groups={groups} categories={categoriesMeta} />
  </div>
</BaseLayout>

<style>
  /* ── 壳：移动端单列；桌面 lg+ 两栏（主流 + Sticky 目录） ── */
  .stream-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: 1.25rem 4rem;
  }
  @media (min-width: 64rem) {
    .stream-shell {
      grid-template-columns: minmax(0, 1fr) 16.5rem;
      gap: 0 2.5rem;
    }
  }

  /* ── 页头 ── */
  .stream-header {
    max-width: 46rem;
  }
  .stream-header__crumb {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
  }
  .stream-header__crumb span {
    margin-inline: 0.25rem;
    color: var(--color-line);
  }
  .stream-header__title {
    margin: 0.375rem 0 0;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .stream-header__desc {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-muted-strong);
  }
  .stream-header__meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0.875rem 0 0;
  }

  /* ── 工具条：视图切换 + Gallery ── */
  .stream-toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-border);
  }
  .stream-view-switch {
    display: inline-flex;
    gap: 0.125rem;
    padding: 0.1875rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-card);
  }
  .stream-view-switch__link {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-feedback) var(--ease-feedback),
      color var(--duration-feedback) var(--ease-feedback);
  }
  .stream-view-switch__link:hover {
    color: var(--color-ink);
  }
  .stream-view-switch__link.is-active {
    background: var(--color-dark-bg);
    color: var(--color-card);
  }
  .stream-toolbar__gallery {
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--color-accent-deep);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-feedback) var(--ease-feedback);
  }
  .stream-toolbar__gallery:hover {
    color: var(--color-ink);
  }

  /* ── Mobile 横向分类 chips（<lg 显示；lg+ 由 Sticky 目录接管） ── */
  .stream-cats {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block: 1rem 0.25rem;
    overflow-x: auto;
  }
  .stream-cats__zh {
    margin-left: 0.25rem;
    color: var(--color-muted);
  }
  @media (min-width: 64rem) {
    .stream-cats {
      display: none;
    }
  }

  /* ── 阅读流 ── */
  .stream-feed {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }

  .stream-cat__head {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .stream-cat__title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-ink);
  }
  .stream-cat__zh {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-muted-strong);
  }
  .stream-cat__count {
    margin-left: auto;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-tag-bg);
    color: var(--color-muted-strong);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
  }
  .stream-cat__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-muted-strong);
  }

  .stream-cat__items {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
  }

  /* ── 读完收尾 ── */
  .stream-footer {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-panel);
    text-align: center;
  }
  .stream-footer__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .stream-footer__text {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .stream-footer__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1rem;
  }
</style>