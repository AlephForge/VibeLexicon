---
// Mini Preview: mega-menu（超级菜单）-- 纯静态，零 JS，Gallery/Stream 用
---
<div class="w-full aspect-[16/9] bg-canvas border border-line rounded-card overflow-hidden p-4 relative">
  <div class="absolute inset-x-4 top-4 bg-card border border-line rounded-control px-3 py-2 flex items-center justify-between z-10">
    <span class="text-[10px] font-medium text-ink">品牌</span>
    <div class="flex gap-2">
      <span class="text-[9px] text-ink border-b border-accent">导航 ▼</span>
      <span class="text-[9px] text-muted">图鉴</span>
      <span class="text-[9px] text-muted">文档</span>
    </div>
  </div>
  <!-- 宽菜单面板 -->
  <div class="absolute top-12 inset-x-6 bg-surface border border-line rounded-control shadow-card p-3 grid grid-cols-3 gap-3 z-20">
    <div class="flex flex-col gap-1">
      <span class="text-[9px] text-accent font-medium mb-0.5">产品</span>
      <span class="h-1 w-full rounded-full bg-line"></span>
      <span class="h-1 w-4/5 rounded-full bg-line"></span>
      <span class="h-1 w-full rounded-full bg-line"></span>
    </div>
    <div class="flex flex-col gap-1">
      <span class="text-[9px] text-accent font-medium mb-0.5">开发者</span>
      <span class="h-1 w-full rounded-full bg-line"></span>
      <span class="h-1 w-2/3 rounded-full bg-line"></span>
      <span class="h-1 w-full rounded-full bg-line"></span>
    </div>
    <div class="flex flex-col gap-1">
      <span class="text-[9px] text-accent font-medium mb-0.5">资源</span>
      <span class="h-1 w-full rounded-full bg-line"></span>
      <span class="h-1 w-4/5 rounded-full bg-line"></span>
      <span class="h-1 w-3/4 rounded-full bg-line"></span>
    </div>
  </div>
</div>