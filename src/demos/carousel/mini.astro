---
// Mini Preview: carousel（轮播图）-- 纯静态，零 JS，Gallery/Stream 用
// 横滑卡片组，两侧卡片部分可见 + 指示点
---
<div class="w-full aspect-[16/9] bg-canvas border border-line rounded-card overflow-hidden p-4 flex flex-col gap-2 relative">
  <div class="flex-1 flex items-center gap-2 overflow-hidden">
    <div class="w-2/5 flex-none h-4/5 rounded-control bg-card border border-line p-2 flex flex-col gap-1 opacity-60 scale-95">
      <div class="flex-1 rounded-md bg-tag-bg"></div>
      <div class="h-1 w-3/4 rounded-full bg-line"></div>
    </div>
    <div class="w-2/5 flex-none h-4/5 rounded-control bg-card border-2 border-accent shadow-card p-2 flex flex-col gap-1 z-10">
      <div class="flex-1 rounded-md bg-accent-soft"></div>
      <div class="h-1 w-3/4 rounded-full bg-accent"></div>
    </div>
    <div class="w-2/5 flex-none h-4/5 rounded-control bg-card border border-line p-2 flex flex-col gap-1 opacity-60 scale-95">
      <div class="flex-1 rounded-md bg-tag-bg"></div>
      <div class="h-1 w-2/3 rounded-full bg-line"></div>
    </div>
  </div>
  <div class="flex items-center justify-center gap-1.5 flex-none">
    <span class="w-1.5 h-1.5 rounded-full bg-line"></span>
    <span class="w-3 h-1.5 rounded-full bg-accent"></span>
    <span class="w-1.5 h-1.5 rounded-full bg-line"></span>
  </div>
</div>