---
// Mini Preview: drawer（抽屉）-- 纯静态，零 JS，Gallery/Stream 用
// 从边缘滑出的临时面板，背景上下文仍可见
---
<div class="w-full aspect-[16/9] bg-canvas border border-line rounded-card overflow-hidden p-4 relative">
  <!-- 背景内容 -->
  <div class="absolute inset-4 rounded-control bg-card border border-line p-3">
    <div class="h-2 w-1/3 rounded-full bg-line mb-2"></div>
    <div class="h-full rounded-md bg-tag-bg"></div>
  </div>
  <!-- 遮罩 + 右侧面板 -->
  <div class="absolute inset-0 rounded-card flex justify-end">
    <div class="absolute inset-0 bg-ink/30"></div>
    <div class="relative w-2/5 h-full bg-surface border-l border-line p-3 flex flex-col gap-2 rounded-l-none">
      <div class="h-2 w-2/3 rounded-full bg-accent"></div>
      <div class="flex-1 flex flex-col gap-1.5">
        <div class="h-1.5 w-full rounded-full bg-line"></div>
        <div class="h-1.5 w-3/4 rounded-full bg-line"></div>
        <div class="h-1.5 w-full rounded-full bg-line"></div>
        <div class="h-1.5 w-1/2 rounded-full bg-line"></div>
      </div>
      <span class="btn btn--primary rounded-control py-1 text-[10px] text-center">操作</span>
    </div>
  </div>
</div>