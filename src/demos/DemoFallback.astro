---
// 未知 preview key 的运行时兜底：绝不渲染空白
// 正常情况下 Content Validator 已拦截非法 key；
// 此处防御脏数据，明确提示关键词。
interface Props {
  key: string;
}
const { key } = Astro.props;
---
<div class="w-full aspect-[16/9] bg-canvas border border-dashed border-accent rounded-card overflow-hidden flex items-center justify-center p-4">
  <p class="text-xs text-accent text-center">
    Preview 未注册（key: <code class="font-mono">{key}</code>）
  </p>
</div>