---
// Mini Preview: dashboard-layout（仪表盘布局）-- 纯静态，零 JS，Gallery/Stream 用
---
<div class="w-full aspect-[16/9] bg-canvas border border-line rounded-card overflow-hidden p-4 flex flex-col gap-2">
  <div class="grid grid-cols-4 gap-2">
    <div class="card-surface rounded-control p-2 flex flex-col gap-1">
      <span class="text-[9px] text-muted">本周访问</span>
      <span class="text-sm font-bold text-ink">12.4k</span>
    </div>
    <div class="card-surface rounded-control p-2 flex flex-col gap-1">
      <span class="text-[9px] text-muted">转化率</span>
      <span class="text-sm font-bold text-ink">3.2%</span>
    </div>
    <div class="card-surface rounded-control p-2 flex flex-col gap-1">
      <span class="text-[9px] text-muted">新用户</span>
      <span class="text-sm font-bold text-ink">+8.1%</span>
    </div>
    <div class="card-surface rounded-control p-2 flex flex-col gap-1">
      <span class="text-[9px] text-muted">活跃会话</span>
      <span class="text-sm font-bold text-ink">891</span>
    </div>
  </div>
  <div class="flex-1 grid grid-cols-3 gap-2">
    <div class="col-span-2 rounded-control bg-card border border-line p-3">
      <div class="h-1.5 w-1/3 rounded-full bg-line mb-2"></div>
      <div class="h-[60%] rounded-md bg-tag-bg"></div>
    </div>
    <div class="rounded-control bg-card border border-line p-3 flex flex-col gap-1.5">
      <div class="h-1.5 w-2/3 rounded-full bg-line"></div>
      <div class="flex-1 rounded-md bg-tag-bg"></div>
    </div>
  </div>
</div>